# /opt/nlo/nlo.env — loaded by nlo.service (chmod 600)
# Never commit real keys.
# One-shot: bash /opt/nlo/app/deploy/setup-coin-bridge.sh

BETTER_AUTH_SECRET=replace-with-long-random-string
BETTER_AUTH_URL=https://nlo.gg

# Stripe — Dashboard → Developers → API keys → Secret key
# Use sk_test_… for testing, sk_live_… for real charges
# Test card: 4242 4242 4242 4242
STRIPE_SECRET_KEY=sk_test_replace_me

# Optional: webhook signing secret if you enable /api/stripe/webhook
# STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Shared secret for the Paper plugin (NLOCoins) talking to the hub.
# Generate with: openssl rand -hex 32
NLO_INTERNAL_SECRET=replace-with-long-random-string

# On-disk PGLite so shop grants survive hub restarts (node-server box).
PGLITE_DATA_DIR=/opt/nlo/pglite

# Optional RCON fallback. Leave disabled — NLOCoins on the Paper box is preferred.
# Do not enable this while NLOCoins is also delivering unless you accept the lease.
# NLO_RCON_ENABLED=0
# NLO_RCON_HOST=127.0.0.1
# NLO_RCON_PORT=25575
# NLO_RCON_PASSWORD=
