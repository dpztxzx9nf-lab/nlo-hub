# /opt/nlo/nlo.env — loaded by nlo.service (chmod 600)
# Never commit real keys.
# One-shot: bash /opt/nlo/app/deploy/setup-coin-bridge.sh
# Deploy also runs: python3 deploy/provision-nlo-env.py

BETTER_AUTH_SECRET=replace-with-long-random-string
BETTER_AUTH_URL=https://nlo.gg

# Production Grok auth broker client (X + Google). Without these, nlo.gg
# falls back to the sandbox preview client and X/Google sign-in fails.
# Callbacks the client must allow:
#   https://nlo.gg/api/auth/oauth2/callback/grok-x
#   https://nlo.gg/api/auth/oauth2/callback/grok-google
# GROK_AUTH_ISSUER=https://auth.grok.me
# GROK_AUTH_CLIENT_ID=replace-me
# GROK_AUTH_CLIENT_SECRET=replace-me

# Stripe — Dashboard → Developers → API keys → Secret key
# Use sk_test_… only while testing. Real shop charges need sk_live_…
# Go live: nano /opt/nlo/stripe.live  then  bash deploy/go-live-stripe.sh
STRIPE_SECRET_KEY=sk_live_replace_me

# Filled by provision-nlo-env.py when STRIPE_SECRET_KEY is real.
# Endpoint: https://nlo.gg/api/stripe/webhook  event: checkout.session.completed
# STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Shared secret for the Paper plugin (NLOCoins) talking to the hub.
# Generate with: openssl rand -hex 32
NLO_INTERNAL_SECRET=replace-with-long-random-string

# On-disk PGLite so shop grants survive hub restarts (node-server box).
PGLITE_DATA_DIR=/opt/nlo/pglite

# Optional RCON fallback. Leave disabled — NLOCoins on the Paper box is preferred.
# Do not enable this while NLOCoins is also delivering unless you accept the lease.
# NLO_RCON_ENABLED=0
# NLO_RCON_HOST=127.0.0.1
# NLO_RCON_PORT=25575
# NLO_RCON_PASSWORD=
